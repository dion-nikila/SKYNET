# SKYNET backend runtime configuration

# Comma-separated frontend origins allowed by CORS.
# Local development default:
SKYNET_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Quick test mode (disables CORS credentials):
# SKYNET_CORS_ORIGINS=*

# Toggle SQLite run logging (1 = enabled, 0 = disabled)
SKYNET_ENABLE_RUN_LOGGING=1

# Optional: explicit model metadata artifact path
# SKYNET_MODEL_META_PATH=/opt/render/project/src/model/xgb_haikou_model_meta.pkl

# Optional: run-log SQLite path.
# Use /tmp on free hosting platforms with ephemeral filesystems.
# SKYNET_SQLITE_PATH=/tmp/skynet_runs.db

# Optional: override project root when running from a non-standard CWD.
# SKYNET_ROOT_DIR=/opt/render/project/src

# Optional: writable matplotlib cache path (recommended in hosted environments).
# MPLCONFIGDIR=/tmp/mplconfig
