# SKYNET frontend runtime configuration

# Backend API base URL.
# If omitted, the frontend defaults to same-origin: window.location.origin + /api/v1
# For Vercel + Render split hosting, set this explicitly to your Render backend URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional API timeout (milliseconds) for fetch requests.
VITE_API_TIMEOUT_MS=20000

# Example production backend URL:
# VITE_API_BASE_URL=https://your-render-service.onrender.com/api/v1
